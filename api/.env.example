# Modèle des réglages de l'API. En développement, `python3 db/roles_connexion.py` génère .env.
ARGOS_PG_HOST=127.0.0.1
ARGOS_PG_PORT=5432
ARGOS_PG_DATABASE=argos_dev
ARGOS_PG_APP_PASSWORD=
ARGOS_PG_IDENTITY_PASSWORD=
ARGOS_REDIS_URL=redis://127.0.0.1:6379/1
ARGOS_HOST=127.0.0.1
ARGOS_PORT=3000
ARGOS_CLE_HMAC=.secrets/hmac.key
ARGOS_CLE_MAIL=.secrets/mail.key
ARGOS_CLE_MFA=.secrets/mfa.key
# Clé secrète de TEST de Cloudflare : accepte toujours (à remplacer en production)
ARGOS_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
ARGOS_URL_PUBLIQUE=http://localhost:5173
# Mails et SMS : « fichier » = faux envoi local, écrit dans ARGOS_BOITE (interdit en production)
ARGOS_MAIL=fichier
ARGOS_SMS=fichier
ARGOS_BOITE=.boite
# Mails réels (ARGOS_MAIL=smtp) : Infomaniak, STARTTLS. Le mot de passe est lu dans un FICHIER
# (systemd-creds en production : /run/credentials/argos-api/smtp), jamais écrit ici.
#ARGOS_SMTP_HOTE=mail.infomaniak.com
#ARGOS_SMTP_PORT=587
#ARGOS_SMTP_UTILISATEUR=contact@argos-veille.fr
#ARGOS_SMTP_MOT_DE_PASSE_FICHIER=.secrets/smtp
#ARGOS_SMTP_EXPEDITEUR=Argos Veille <contact@argos-veille.fr>
# SMS réels (ARGOS_SMS=ovh) : API d'OVHcloud. Clés dans un FICHIER JSON
# { "cleApplication": "…", "secretApplication": "…", "cleConsommateur": "…" } (systemd-creds en production).
#ARGOS_OVH_SMS_SERVICE=sms-xx00000-1
#ARGOS_OVH_SECRETS_FICHIER=.secrets/ovh.json
#ARGOS_OVH_SMS_EXPEDITEUR=ArgosVeille   (facultatif : nom d'expéditeur à faire valider par OVH)
# Cloudflare R2 (obligatoire en production) : compartiment privé en juridiction européenne. Clés dans un
# FICHIER JSON { "cleAcces": "…", "secret": "…" } (jeton « Lecture/écriture objet » limité au compartiment).
#ARGOS_R2_POINT=https://<compte>.eu.r2.cloudflarestorage.com
#ARGOS_R2_COMPARTIMENT=argos-videos
#ARGOS_R2_SECRETS_FICHIER=.secrets/r2.json
ARGOS_SMS_PLAFOND_JOUR=200
ARGOS_STOCKAGE=.stockage/originaux
ARGOS_QUARANTAINE=.stockage/quarantaine
ARGOS_FLOUTEES=.stockage/floutees
# Copies de travail chiffrées par la clé de copie de la source, gardées 7 jours au plus
ARGOS_COPIES=.stockage/copies
ARGOS_ENVOIS_PAR_HEURE=60
# Envois par adresse IP et par 24 h (5 si absent ; plus haut en développement pour les tests)
ARGOS_ENVOIS_PAR_IP_JOUR=5

# --- Production -----------------------------------------------------------------------------------
# Secrets lus dans des fichiers (systemd-creds : /run/credentials/<service>/…) plutôt que dans ce fichier :
#   ARGOS_PG_APP_PASSWORD_FICHIER, ARGOS_PG_IDENTITY_PASSWORD_FICHIER, ARGOS_TURNSTILE_SECRET_FICHIER
# Instance publique (derrière cloudflared) :
#ARGOS_PROXY_LOCAL=oui            # adresse du visiteur dans X-Forwarded-For (connexions de la boucle locale seulement)
#ARGOS_PREFIXE_API=/api           # le tunnel envoie /api/… à l'API
#ARGOS_ADMINISTRATION=non         # aucune route /admin/*
#ARGOS_TACHES=oui                 # nettoyage, dépôt R2, convocations
# Instance d'administration (réseau privé) :
#ARGOS_ADMINISTRATION=oui
#ARGOS_ORIGINE=https://admin.argos-veille.fr   # ARGOS_URL_PUBLIQUE reste https://argos-veille.fr (liens des mails, clés)
#ARGOS_TACHES=non
