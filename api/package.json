{
  "name": "argos-api",
  "version": "0.1.0",
  "private": true,
  "description": "API d'Argos (argos-veille.fr)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "moteur": "node --env-file=.env.moteur --import tsx src/moteur.ts",
    "test": "node --env-file=.env --env-file=.env.test --import tsx --test --test-concurrency=1 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "libphonenumber-js": "1.13.15",
    "nodemailer": "10.2.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
